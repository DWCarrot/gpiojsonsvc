{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'gpiojsonsvc'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=gpiojsonsvc"
                ]
            },
            "args": []
        },
        {
            "name": "Debug unit tests in executable 'gpiojsonsvc'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=gpiojsonsvc"
                ]
            }
        },
        {
            "name": "Debug integration test 'smoke'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--test=smoke"
                ]
            }
        },
        {
            "name": "Debug gpiojsonsvc with mock backend",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/gpiojsonsvc",
            "args": [
                "--mock",
                "${workspaceFolder}/tmp/config.toml",
            ],
            "cwd": "${workspaceFolder}/tmp",
            "env": {
                "GPIOJSONSVC_MOCK_LOG": "${workspaceFolder}/tmp/log/dumps.txt",
                "RUST_LOG": "debug"
            },
            "console": "integratedTerminal"
        }
    ]
}